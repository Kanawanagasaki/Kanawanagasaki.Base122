<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package metadata -->
    <PackageId>Kanawanagasaki.Base122</PackageId>
    <Version>0.1.0</Version>
    <Authors>Kanawanagasaki</Authors>
    <Description>High-performance Base122 binary-to-text encoding (UTF-8 safe, ~14% overhead; Base64 adds 33%) with span-based and streaming APIs. C# port of the Rust base122-fast scalar codec.</Description>
    <PackageTags>base122;binary-to-text;encoding;utf8;utf-8;base64-alternative;span;stream;performance</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Symbols -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Produce the .nupkg on release builds -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
